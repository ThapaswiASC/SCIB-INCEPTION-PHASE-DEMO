                  "pm.test(\"Error details contain title validation\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.details).to.be.an('array');",
                  "    var titleError = jsonData.details.find(d => d.includes('title'));",
                  "    pm.expect(titleError).to.exist;",
