{
  "info": {
    "name": "MyProject API Collection",
    "description": "API test collection for MyProject task management system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "{{base_url}}"},
    {"key": "task_id", "value": ""},
    {"key": "user_id", "value": "1"},
    {"key": "column_id", "value": "to-do"}
  ],
  "item": [
    {
      "name": "Task Management",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Test Task\",\n  \"description\": \"Test\",\n  \"userId\": 1,\n  \"priority\": \"HIGH\"\n}"},
            "url": {"raw": "{{base_url}}/v1/tasks", "host": ["{{base_url}}"], "path": ["v1", "tasks"]}
          }
        }
      ]
    }
  ]
}