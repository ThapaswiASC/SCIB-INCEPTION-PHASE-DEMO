          "name": "Bulk Create Tasks - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has totalCreated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalCreated');",
                  "    pm.expect(jsonData.totalCreated).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test('Response has tasks array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.tasks).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Response has errors array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.errors).to.be.an('array');",
                  "});"
                ],
