                  "pm.test(\"Response has validation error code\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"VALIDATION_ERROR\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
