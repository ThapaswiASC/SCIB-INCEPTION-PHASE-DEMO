{
  "info": {
    "name": "MyProject Task Management API",
    "description": "Comprehensive API test collection for Task Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "{{base_url}}",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Get Health Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has status UP', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('UP');",
                  "});",
                  "",
                  "pm.test('Response has application name', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.application).to.eql('myproject');",
                  "});",
                  "",
                  "pm.test('Response has timestamp', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.timestamp).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/health",
              "host": ["{{base_url}}"],
              "path": ["v1", "health"]
            }
          }
        },
        {
          "name": "Get Performance Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has totalTasksCreated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalTasksCreated');",
                  "});",
                  "",
                  "pm.test('Response has averageCreationTimeMs', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('averageCreationTimeMs');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/health/metrics",
              "host": ["{{base_url}}"],
              "path": ["v1", "health", "metrics"]
            }
          }
        }
      ]
    },
    {
      "name": "Task Management",
      "item": [
        {
          "name": "Create Task - Valid Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has task ID', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.environment.set('task_id', jsonData.id);",
                  "});",
                  "",
                  "pm.test('Task has correct title', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql('Test Task');",
                  "});",
                  "",
                  "pm.test('Task has correct status', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('PENDING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  "userId": {{user_id}},\n  "title": "Test Task",\n  "description": "Test Description",\n  "priority": "HIGH"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/tasks",
              "host": ["{{base_url}}"],
              "path": ["v1", "tasks"]
            }
          }
        },
        {
          "name": "Create Task - Missing Title",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response has error code', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.errorCode).to.eql('VALIDATION_ERROR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  "userId": {{user_id}},\n  "description": "Test Description",\n  "priority": "HIGH"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/tasks",
              "host": ["{{base_url}}"],
              "path": ["v1", "tasks"]
            }
          }
        },
        {
          "name": "Get User Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/users/{{user_id}}/tasks?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["v1", "users", "{{user_id}}", "tasks"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Task Count",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has userId', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.userId).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Response has taskCount', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.taskCount).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/users/{{user_id}}/tasks/count",
              "host": ["{{base_url}}"],
              "path": ["v1", "users", "{{user_id}}", "tasks", "count"]
            }
          }
        },
        {
          "name": "Get Task By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has task details', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "Update Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Task title is updated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql('Updated Task Title');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  "title": "Updated Task Title",\n  "status": "IN_PROGRESS"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "Delete Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "tasks", "{{task_id}}"]
            }
          }
        },
        {
          "name": "Bulk Create Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has success count', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.successCount).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Response has tasks array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.tasks).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    "userId": {{user_id}},\n    "title": "Bulk Task 1",\n    "description": "Description 1",\n    "priority": "HIGH"\n  },\n  {\n    "userId": {{user_id}},\n    "title": "Bulk Task 2",\n    "description": "Description 2",\n    "priority": "MEDIUM"\n  }\n]"
            },
            "url": {
              "raw": "{{base_url}}/v1/tasks/bulk",
              "host": ["{{base_url}}"],
              "path": ["v1", "tasks", "bulk"]
            }
          }
        }
      ]
    }
  ]
}