        {
          "name": "Bulk Create Tasks - Valid Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success count\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.successCount).to.be.a('number');",
                  "    pm.expect(jsonData.successCount).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test(\"Response has failure count\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.failureCount).to.be.a('number');",
                  "});",
                  "",
                  "pm.test(\"Response has tasks array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.tasks).to.be.an('array');",
                  "});"
                ],
